 },
 "name": "Editorial Serif (moves)",
 "descriptor": "Literate · Confident · Spacious",
 "influences": "Magazine editorial / Swiss columns / Book typography",
 "summary": "Magazine pages set in a high-contrast serif, with hairline rules and room to breathe.",
 "coreTrick": "Set the page like a magazine: weight comes from contrast (400-weight serif, one italic accent word, small-caps sans labels) and structure from hairline and thick-over-thin rules on a cream-warmed paper canvas, with a duotone cover plate mixed from the primary as the only filled object.",
 "motto": "Set it like a page.",
 "kicker": "Issue 01 — Spring",
 "mode": "light",
