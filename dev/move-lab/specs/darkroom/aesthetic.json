{
 "spec": 2,
 "key": "darkroom",
 "order": 960,
 "name": "Darkroom",
 "descriptor": "Safelight · Contact · Tray",
 "influences": "Film contact sheets, 35mm film rebate edges with frame numbers, grease-pencil pick marks, enlarger-room trays and safelight glow",
 "summary": "A photo darkroom under the safelight: every surface is a numbered film frame or a recessed developer tray.",
 "coreTrick": "The canvas is a near-black warm room and every surface is either a hairline-framed contact-sheet cell (numbered like film frames, with a printed rebate strip of frame numbers on the board edges) or a recessed tray, and the picked or selected item gets a primary-colour grease-pencil rule instead of a fill.",
 "motto": "Print the pick.",
 "kicker": "Roll 07 / Contact sheet",
 "mode": "dark",
 "lineage": {
  "forkedFrom": null,
  "version": 2
 },
 "meta": {
  "family": "graphic",
  "fonts": {
   "heading": {
    "classes": [
     "condensed",
     "neo-grotesk"
    ],
    "picks": [
     "Barlow Condensed",
     "Archivo",
     "Inter Tight"
    ]
   },
   "body": {
    "classes": [
     "neo-grotesk"
    ],
    "picks": [
     "Inter Tight",
     "Archivo"
    ]
   },
   "mono": {
    "picks": [
     "IBM Plex Mono",
     "DM Mono",
     "Space Mono"
    ]
   },
   "avoid": [
    "didone",
    "script",
    "groovy",
    "soft-serif"
   ],
   "why": "Condensed caps read like edge-printed film stock; mono carries frame numbers and labels; a quiet neo-grotesk keeps body text out of the way.",
   "pairings": [
    [
     "Barlow Condensed",
     "Inter Tight"
    ],
    [
     "Archivo",
     "IBM Plex Mono"
    ]
   ]
  }
 },
 "build": {
  "cls": "flat",
  "surface": "Near-black canvas; hairline frames for holding things, recessed trays for containers, no outer shadows.",
  "press": {
   "dx": 0,
   "dy": 1,
   "ms": 120
  },
  "motion": {
   "fast": 120,
   "base": 200,
   "slow": 320,
   "ease": "out"
  },
  "pressText": "Rest: hairline frame. Hover: frame brightens to the safelight colour. Pressed: sinks 1px.",
  "icons": "Thin 1.5px strokes, square caps, selected icons get a grease-pencil underline.",
  "appIcon": "Black tile with one 35mm frame outline and a primary-colour grease-pencil circle around it."
 },
 "labels": {
  "material": "Frame and tray",
  "states": [
   "Rest",
   "Safelit",
   "Dunked"
  ],
  "statesKind": "button"
 },
 "copy": {
  "motto": {
   "label": "Motto",
   "text": "Print the pick."
  },
  "kicker": {
   "label": "Kicker above the headline",
   "text": "Roll 07 / Contact sheet"
  }
 },
 "layout": {
  "hero": "centered",
  "palette": "strips",
  "sections": "stacked"
 },
 "type": {
  "ui": "sans",
  "label": "mono",
  "display": 1.1
 },
 "roles": {
  "canvas": {
   "use": "The dark room: near-black, warm-tinted toward the primary",
   "never": "Text",
   "coverage": "70-80%"
  },
  "ink": {
   "use": "Headlines, body text, borders, hover fill",
   "never": "Large background fields in light mode",
   "coverage": "15-20%"
  },
  "primary": {
   "use": "The safelight: the one main action and grease-pencil pick marks",
   "never": "Body text; more than one CTA per view",
   "coverage": "about 10%"
  },
  "secondary": {
   "use": "Secondary buttons, chips, second data series",
   "never": "The main CTA, body text",
   "coverage": "10-15%"
  },
  "accent": {
   "use": "One frame number or tag lit per view",
   "never": "Buttons, body text, borders, large fills",
   "coverage": "5% or less"
  }
 },
 "rules": {
  "do": [
   "Number every cell like a film frame.",
   "Mark the selected item with a primary rule, not a fill.",
   "Use hairlines for holding things and a recessed tray for containers."
  ],
  "dont": [
   "Put a glow or blur shadow on a control.",
   "Show art on app screens.",
   "Fill large areas with the primary colour."
  ]
 },
 "highlight": "band",
 "slideShape": "geometric",
 "colour": [
  {
   "move": "tinted-neutral-canvas",
   "params": {
    "tint": 8,
    "darkL": 7,
    "paperMix": 0.2
