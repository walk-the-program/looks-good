  "build": {
    "cls": "soft",
    "press": {
      "ms": 140
    },
    "motion": {
      "fast": 120,
      "base": 180,
      "slow": 320,
      "ease": "inout"
    },
    "pressText": "A raised control becomes recessed: the paired shadows swap to inset over 140 ms (ease-in-out). The glossy primary action also sinks 1pt and scales to 0.99 with an inset 1,2,4 shadow. The light never moves: top left, always.",
    "icons": "Stroke 1.75pt, round caps and joins, 2pt corners on geometric forms (circle, square, semicircle). Outline at rest; selected sits on a chip filled with `--ink`, glyph in `--canvas`. No gradients inside glyphs.",
    "appIcon": "`{canvas}` tile carrying one raised disc off-centre inside a recessed well, with a `{primary}` semicircle crossing the well rim, lit from the top left by the same highlight and shadow pair as the UI; no text, no other colour."
  },
  "name": "Soft Form (moves)",
  "descriptor": "Warm · Graphic · Tactile",
  "influences": "Bauhaus / Neumorphism / Prism",
  "summary": "Quiet, tactile surfaces that look pressed into and lifted out of the same material.",
  "coreTrick": "Fill every surface with the canvas colour itself and let a paired dark/light shadow (offset down-right / up-left, derived from the canvas) make it look raised or recessed, with one iridescent glass panel and one glossy primary.",
  "motto": "Precise structure. Soft edges.",
  "kicker": "Geometry with feeling",
  "mode": "light",
  "slideShape": "soft",
  "labels": {
    "material": "Touch & depth",
    "states": [
      "Raised",
      "Recessed",
      "Glass"
    ]
  },
  "copy": {
    "motto": {
      "label": "Motto",
      "text": "Precise structure. Soft edges."
    },
    "kicker": {
      "label": "Kicker above the headline",
      "text": "Geometry with feeling"
    },
    "state0": {
      "label": "State 1 name",
      "text": "Raised"
    },
    "state1": {
      "label": "State 2 name",
      "text": "Recessed"
