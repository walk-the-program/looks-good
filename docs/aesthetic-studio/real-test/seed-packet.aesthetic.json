          {
            "id": "r3b",
            "change": "structure: added tear-line on hero and footer, plus tear-edge on card and modal",
            "verdict": "keep"
          },
          {
            "id": "r3c",
            "change": "structure: hero kicker as stamped-label",
            "verdict": "keep"
          },
          {
            "id": "r3d",
            "change": "material (button-primary): hard-offset -> ink-stamp",
            "verdict": "keep"
          },
          {
            "id": "r3e",
            "change": "palette layout: swatches -> chips (palette-board-form)",
            "verdict": "keep"
          }
        ],
        "notes": [
