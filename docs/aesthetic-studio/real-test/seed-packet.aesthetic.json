  "art": {
    "art/hero.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-20 0 240 240\">\n  <!-- botanical engraving: a sprouting seed with roots and two leaves, ink line work plus one flat colour ink -->\n  <rect x=\"-20\" width=\"240\" height=\"240\" fill=\"#f4ecd8\"/>\n  <rect x=\"8\" y=\"8\" width=\"184\" height=\"224\" fill=\"none\" stroke=\"#1b1b1b\" stroke-width=\"2.5\"/>\n  <rect x=\"13\" y=\"13\" width=\"174\" height=\"214\" fill=\"none\" stroke=\"#1b1b1b\" stroke-width=\"0.8\"/>\n  <!-- flat second ink: leaf blades -->\n  <path d=\"M100 118 C 84 100 62 98 48 108 C 62 126 86 128 100 118 Z\" style=\"fill:var(--ab-secondary,#3f7a4a)\"/>\n  <path d=\"M100 96 C 114 74 138 66 156 74 C 144 96 120 106 100 96 Z\" style=\"fill:var(--ab-secondary,#3f7a4a)\"/>\n  <!-- leaf veins -->\n  <g fill=\"none\" stroke=\"#1b1b1b\" stroke-width=\"1.1\" stroke-linecap=\"round\">\n    <path d=\"M100 118 C 84 112 66 108 50 108\"/>\n    <path d=\"M86 112 L78 104 M74 109 L68 102 M92 115 L86 122 M80 114 L74 121 M66 109 L62 115\"/>\n    <path d=\"M100 96 C 114 90 136 80 154 74\"/>\n    <path d=\"M114 91 L120 82 M126 86 L130 77 M138 80 L140 72 M112 93 L116 100 M124 89 L128 96 M136 83 L140 90\"/>\n  </g>\n  <!-- stem -->\n  <g fill=\"none\" stroke=\"#1b1b1b\" stroke-width=\"2\" stroke-linecap=\"round\">\n    <path d=\"M100 150 C 100 132 98 118 100 96 C 101 84 100 76 100 66\"/>\n    <path d=\"M96 150 C 96 130 94 116 96 96 M104 150 C 104 130 103 116 104 98\" stroke-width=\"0.8\"/>\n  </g>\n  <!-- bud -->\n  <path d=\"M100 66 C 92 56 94 42 100 34 C 106 42 108 56 100 66 Z\" fill=\"none\" stroke=\"#1b1b1b\" stroke-width=\"1.6\"/>\n  <path d=\"M100 66 C 98 56 98 46 100 38 M100 66 C 102 56 102 46 100 38\" fill=\"none\" stroke=\"#1b1b1b\" stroke-width=\"0.8\"/>\n  <!-- soil line, hatched -->\n  <path d=\"M26 150 L174 150\" stroke=\"#1b1b1b\" stroke-width=\"2.2\"/>\n  <g stroke=\"#1b1b1b\" stroke-width=\"0.9\" stroke-linecap=\"round\">\n    <path d=\"M30 156 L38 162 M44 156 L52 162 M58 156 L66 162 M72 156 L80 162 M120 156 L128 162 M134 156 L142 162 M148 156 L156 162 M162 156 L170 162\"/>\n    <path d=\"M36 168 L44 174 M50 168 L58 174 M64 168 L72 174 M128 168 L136 174 M142 168 L150 174 M156 168 L164 174\"/>\n  </g>\n  <!-- seed husk under the soil -->\n  <path d=\"M86 164 C 86 150 114 150 114 164 C 114 176 100 182 100 182 C 100 182 86 176 86 164 Z\" style=\"fill:var(--ab-secondary,#3f7a4a);fill-opacity:0.35\" stroke=\"#1b1b1b\" stroke-width=\"1.6\"/>\n  <!-- roots -->\n  <g fill=\"none\" stroke=\"#1b1b1b\" stroke-width=\"1.3\" stroke-linecap=\"round\">\n    <path d=\"M100 182 C 100 192 96 198 92 204 M100 182 C 102 192 108 196 112 204 M100 188 C 94 190 88 192 84 196 M101 190 C 108 190 114 190 120 194\"/>\n    <path d=\"M92 204 L88 208 M92 204 L94 209 M112 204 L116 208 M112 204 L110 209\"/>\n  </g>\n  <!-- caption plate -->\n  <rect x=\"48\" y=\"212\" width=\"104\" height=\"12\" fill=\"none\" stroke=\"#1b1b1b\" stroke-width=\"0.8\"/>\n  <text x=\"100\" y=\"221\" text-anchor=\"middle\" font-family=\"Courier New, monospace\" font-size=\"7\" letter-spacing=\"1.6\" fill=\"#1b1b1b\">FIG. 1 · SEEDLING</text>\n</svg>\n"
  },
