        "notes": [
          {
            "id": "n1",
            "target": "board.hero",
            "text": "The core trick is not on the board yet. Nothing reads as a seed packet: no perforated tear line, no rubber-stamped label. The hero should feel like the front of a packet: a stamped lot label near the headline and a perforated tear strip across the bottom of the hero.",
            "status": "done",
            "doneIn": 3
          },
          {
            "id": "n2",
            "target": "board.hero",
            "text": "The art is the generic circle-and-shapes placeholder. Replace it with a botanical engraving: a sprouting seed or a seedling drawn in ink line work, printed in one or two flat inks like an old packet illustration.",
            "status": "done",
            "doneIn": 3
          },
          {
            "id": "n3",
            "target": "kit.button-primary",
            "text": "Buttons are still a generic blue slab with a hard border. They should look rubber-stamped: an ink outline with a slightly worn edge on kraft, caps text, and the fill as a flat printed ink, not a screen-blue panel.",
            "status": "done",
            "doneIn": 3
          }
        ]
      },
      {
        "n": 2,
        "date": "2026-11-07",
        "by": "studio",
        "summary": "Square corners everywhere; palette chips need to read as printed swatches.",
        "changes": [],
        "variants": [
          {
            "id": "r2a",
            "change": "corner-radius: round on → off",
            "verdict": "keep"
          },
          {
            "id": "r2b",
            "change": "edge-underline: width 2 → 5",
            "verdict": "kill"
          },
          {
            "id": "r2c",
            "change": "corner-radius: controls 1 → 2",
            "verdict": "kill"
          }
        ],
        "notes": [
          {
            "id": "n4",
            "target": "board.palette",
            "text": "Palette chips are plain screen tiles. Print them as colour swatches the way a packet shows the flower colour: square chips with a printed caption and a thin ink keyline.",
            "status": "done",
            "doneIn": 3
          }
        ]
      },
      {
        "n": 3,
        "date": "2026-11-07",
        "by": "agent",
        "summary": "The packet now reads on the board: a botanical engraving, a stamped lot label, perforated tear lines and stamped-ink buttons on kraft.",
        "changes": [
          "art.hero: generic circle-and-shapes placeholder replaced by a framed botanical engraving of a sprouting seed, ink line work with one flat green ink",
          "new moves in js/moves/printed-stock.js: tear-line, stamped-label, ink-stamp, tear-edge (generic, with params)",
          "added board moves stamped-label (hero kicker as a tilted, worn rubber stamp) and tear-line (perforated line under the hero and above the footer, captioned Tear here)",
          "kit.button-primary: hard-offset -> ink-stamp (dulled flat ink, inner keyline, caps text, speckled wear); ink-stamp also listed in moves because its text-contrast tokens only run from there",
          "kit.card and kit.modal: hard-offset -> tear-edge (ink frame with a perforated strip along the bottom)",
          "layout.palette: swatches -> chips with palette-board-form (square chips with a keyline and a caps caption)"
        ],
        "variants": [
          {
            "id": "r3a",
            "change": "art: placeholder shapes -> botanical engraving svg",
            "verdict": "keep"
