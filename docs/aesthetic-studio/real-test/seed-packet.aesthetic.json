          "summary: \"One sentence a stranger understands.\" → \"A brand dressed as a vintage seed packe…\"",
          "influences: \"Plain list of what this draws on (stage…\" → \"1930s–50s seed packets, mail-order nurs…\"",
          "meta.family: \"graphic\" → \"print\"",
          "build.cls: \"hard\" → \"flat\"",
          "added colour move warm-paper-canvas",
