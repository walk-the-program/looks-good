   "coverage": "about 10%"
  },
  "secondary": {
   "use": "Secondary buttons, chips, second data series",
   "never": "The main CTA, body text",
   "coverage": "10-15%"
  },
  "accent": {
   "use": "One spark per view: the highlighted headline word, new badges",
   "never": "Buttons, body text, borders, large fills",
   "coverage": "5% or less"
  }
 },
