{
 "spec": 2,
 "key": "youch-voice-line",
 "order": 960,
 "name": "Voice Line",
 "descriptor": "Spoken · Ruled · Exact",
 "influences": "Bauhaus posters (Bayer, Moholy-Nagy) / court stenographer's transcripts / tape counters / Swiss ledgers",
 "summary": "A plain ruled interface where only spoken things are round and periwinkle, and everything written sits as ink on a straight line.",
 "coreTrick": "Round means spoken, straight means written: periwinkle discs only ever mark voice, while every control, selection and container is a straight-edged ink shape with 6px corners at most, and structure is drawn with rules instead of cards.",
 "motto": "Say it. Keep it straight.",
 "kicker": "Hold, talk, let go",
 "mode": "light",
 "lineage": {
  "forkedFrom": null,
  "version": 1
 },
 "meta": {
  "family": "graphic",
  "fonts": {
   "heading": {
    "classes": [
     "geometric"
    ],
    "picks": [
     "Outfit",
     "Jost",
     "Urbanist"
    ]
   },
   "body": {
    "classes": [
     "neo-grotesk"
    ],
    "picks": [
     "Inter",
     "IBM Plex Sans"
    ]
   },
   "mono": {
    "picks": [
     "IBM Plex Mono"
    ]
   },
   "avoid": [
    "didone",
    "script",
    "groovy",
    "pixel",
    "blackletter",
    "woodtype"
   ],
   "why": "A geometric display face echoes the circle-and-line grammar at poster scale, and a plain neo-grotesk with tabular figures keeps transcripts, times and settings exact.",
   "pairings": [
    [
     "Outfit",
     "Inter"
    ],
    [
     "Jost",
     "Inter"
    ],
    [
     "Urbanist",
     "IBM Plex Sans"
    ]
   ]
  }
 },
 "build": {
  "cls": "flat",
  "surface": "Flat canvas with no cards: groups are made by space and by rules (a 2px ink rule under titles and down the sidebar edge, 1px hairlines between rows). Controls are straight-edged with 6px corners and a 2px ink line; the only round shapes are voice: periwinkle discs for audio, clips, speakers and listening.",
  "press": {
   "dy": 1,
   "ms": 80
  },
  "motion": {
   "fast": 120,
   "base": 180,
   "slow": 240,
   "ease": "out"
  },
  "pressText": "Pressed controls move 1px down over 80 ms with no colour change; hover fills a secondary control with a faint ink wash in 120 ms; the selected item fills with ink and its text flips to canvas, sliding 180 ms when the selection moves.",
  "icons": "Text-first: nav and buttons carry no icons; where an icon is needed it is a 1.75px stroke, square caps, drawn on a 20px grid.",
  "appIcon": "The navy ripple tile: a periwinkle disc with cream arcs on #16214a."
 },
 "labels": {
  "material": "Ink line",
  "states": [
   "Rest",
   "Hover",
   "Chosen"
  ],
  "statesKind": "button"
 },
 "copy": {
  "motto": {
   "label": "Motto",
   "text": "Say it. Keep it straight."
  },
  "kicker": {
   "label": "Kicker above the headline",
   "text": "Hold, talk, let go"
  },
  "rule": {
   "label": "The rule",
   "text": "Round is voice. Straight is text."
  }
 },
 "layout": {
  "hero": "split",
  "palette": "strips",
  "sections": "asym"
 },
 "type": {
  "ui": "sans",
  "label": "sans",
  "display": 1.0
 },
 "roles": {
  "canvas": {
   "use": "Every surface; the page is one plane, grouped by rules and space",
   "never": "Text",
   "coverage": "70-80%"
  },
  "ink": {
   "use": "Text, rules, control lines, the selected item and the main action (solid ink fills)",
   "never": "Voice marks",
   "coverage": "15-20%"
  },
  "primary": {
   "use": "Voice only: listening, audio play heads, voice clips, speaker discs, the start dot of each dictation",
   "never": "Buttons, selection, text, borders, large fills",
   "coverage": "3-5%"
  },
  "secondary": {
   "use": "The flat area under the Insights line",
   "never": "Controls, text",
   "coverage": "under 5%"
  },
  "accent": {
   "use": "One small solid disc per screen marking something Youch! learned",
   "never": "Behind text, bands, buttons, borders",
   "coverage": "under 1%"
  }
 },
 "rules": {
  "do": [
   "Draw only spoken things round and periwinkle: listening, audio, clips, speakers and each dictation's start dot.",
   "Fill the selected item and the main action with solid ink; selection reads without colour.",
   "Group with rules and space: a 2px ink rule under page titles and down the sidebar edge, 1px hairlines between rows.",
   "Keep corners at 6px on controls and 0 on planes; circles only for voice.",
   "Set page titles in the geometric display face at 56px or more, flush left and tight; set every number in tabular figures.",
   "Show what was said beside what was kept, with removals struck through and time codes in a left gutter."
  ],
  "dont": [
   "Put a colour band or highlight behind a title or a word (killed by the owner).",
   "Use periwinkle on a button, a selected nav item or a segment.",
   "Box lists or groups in cards; no shadows, gradients, blur or glass.",
   "Draw a lollipop chart; Insights is a flat area under one ink line.",
   "Put board art, shapes or stripes on app screens.",
   "Set nav items, buttons or inline actions in tracked capitals; tracked caps are for section labels only."
  ]
 },
 "highlight": "ink",
 "slideShape": "geometric",
 "colour": [
  {
   "move": "canvas-ink-pull",
   "params": {
    "light": 0,
    "dark": 0
   }
  },
  {
   "move": "muted-contrast-floor",
   "params": {
    "min": 5.0
   }
  },
  {
   "move": "state-colour-derivation",
   "params": {
    "pressMix": 0.84,
    "hoverMix": 0.94
   }
  },
  {
