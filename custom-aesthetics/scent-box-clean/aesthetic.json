{
 "spec": 2,
 "key": "scent-box-clean",
 "order": 970,
 "name": "Scent Box Clean",
 "descriptor": "Quiet · Tiled · Soft",
 "influences": "Muji and Aesop shop shelves / printed perfume-house swatch cards / Apple Notes and Things / Swiss price lists",
 "summary": "Soft warm-grey tiles in an even bento grid on a quiet ground, with nothing ruled or shadowed, so scent colour is the only colour.",
 "coreTrick": "Every container is a flat, soft-tint tile of one radius sitting in a grid of equal gutters on a quiet warm-white ground, with no border, rule or shadow, and a chosen thing is marked by a tint pill with ink text, so the only saturated colour is the scent data.",
 "motto": "Let the scent be the colour.",
 "kicker": "A quiet shelf",
 "mode": "light",
 "lineage": {
  "forkedFrom": null,
  "version": 1
 },
 "meta": {
  "family": "print",
  "fonts": {
   "heading": {
    "classes": [
     "geometric",
     "neo-grotesk"
    ],
    "picks": [
     "DM Sans",
     "Figtree"
    ]
   },
   "body": {
    "classes": [
     "geometric",
     "neo-grotesk"
    ],
    "picks": [
     "DM Sans",
     "Figtree"
    ]
   },
   "mono": {
    "picks": [
     "JetBrains Mono",
     "IBM Plex Mono"
    ]
   },
   "avoid": [
    "script",
    "groovy",
    "blackletter",
    "deco",
    "pixel",
    "heavy",
    "woodtype"
   ],
   "why": "One calm sans at regular and medium weights keeps names, sizes and notes even, so the scent colours are the only loud thing on the page.",
   "pairings": [
    [
     "DM Sans",
     "DM Sans"
    ],
    [
     "Figtree",
     "Figtree"
    ]
   ]
  }
 },
 "build": {
  "cls": "flat",
  "surface": "Flat tiles a step off the warm-white ground, one radius (18px cards, pills for controls), equal gutters, no border, rule, shadow or gradient. Fields are the same tile. Chosen tabs and segments are a tint pill with ink text; only the main action is ink-filled.",
  "press": {
   "dx": 0,
   "dy": 0,
   "ms": 120
  },
  "motion": {
   "fast": 100,
   "base": 160,
   "slow": 240,
   "ease": "out"
  },
  "pressText": "Rest is flat. Hover deepens the tile tint one step. Pressed drops opacity to 85% over 120 ms with no movement. Focus is a 2px ink outline 2px off the edge. Disabled text goes muted.",
  "icons": "1.5px strokes, round caps, 20px; the selected icon is ink with a 1px rule beneath.",
  "appIcon": "A warm-white rounded tile with one thin ink outline of a bottle and a single tinted drop."
 },
 "labels": {
  "material": "Soft tile",
  "states": [
   "Rest",
   "Chosen",
   "Pressed"
  ],
  "statesKind": "chip"
 },
 "copy": {
  "motto": {
   "label": "Motto",
   "text": "Let the scent be the colour."
  },
  "kicker": {
   "label": "Kicker above the headline",
   "text": "A quiet shelf"
  }
 },
 "layout": {
  "hero": "split",
  "palette": "swatches",
  "sections": "two-col"
 },
 "type": {
  "ui": "sans",
  "label": "sans",
  "display": 1
 },
 "roles": {
  "canvas": {
   "use": "Page ground, a warm white in light and a warm near-black in dark; never pure",
   "never": "Text",
   "coverage": "70-80%"
  },
  "ink": {
   "use": "Names, body text, hairlines on hover, the one filled action",
   "never": "Large background fields in light mode",
   "coverage": "10-15%"
  },
  "primary": {
   "use": "The one main action and the chosen mark; kept close to ink so it never competes with scent colours",
   "never": "Card fills, body text, accord chips",
   "coverage": "about 5%"
  },
  "secondary": {
   "use": "Quiet wash for the chosen row and badges",
   "never": "Main action, body text",
   "coverage": "5-10%"
  },
  "accent": {
   "use": "One small brass mark per view: a rating star or a new badge",
   "never": "Buttons, borders, fills, body text",
   "coverage": "2% or less"
  }
 },
 "rules": {
  "do": [
   "Put every group in a flat soft-tint tile of one radius, with equal gutters between tiles, on a warm-white ground.",
   "Mix tile sizes in a grid: one wide tile for title, tabs and search, small tiles for numbers, medium tiles for items.",
   "Let scent colour (bottle tints, accord chips) be the only strong colour on screen.",
   "Mark the chosen tab or segment with a tint pill and ink text; keep the one ink-filled action per view.",
   "Drop eyebrow labels where the tile already says what it is; fewer words, fewer visible controls.",
   "Set everything in one sans at regular and medium weight; numbers in tabular figures."
  ],
  "dont": [
   "Use hairline rules between rows, chevrons on tiles, or borders around tiles.",
   "Use gradients, textures, glass blur or shadows on any surface (bottle tints excepted).",
   "Colour the interface itself: tiles, tabs and buttons stay ink and warm grey.",
   "Fill a selected tab or segment with solid black.",
   "Pin a bar over content; keep Add in the header or a small round plus.",
   "Use a serif or a second font family, or add dashboard widgets and charts."
  ]
 },
 "highlight": "ink",
 "slideShape": "minimal",
