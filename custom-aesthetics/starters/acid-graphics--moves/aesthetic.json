      },
      "avoid": [
        "serif",
        "rounded",
        "deco"
      ],
      "why": "Warped, stretched headlines need an extended or heavy face that survives distortion, while the dense info layer stays in a plain grotesk and mono.",
      "pairings": [
        [
          "Tilt Warp",
          "Inter"
        ],
        [
          "Syncopate",
          "Space Grotesk"
        ],
        [
          "Michroma",
          "Kode Mono"
        ]
      ]
    }
  },
  "build": {
    "cls": "glow",
    "surface": "Near-black panels with a 1pt coloured edge and a soft glow of the same colour. The clash colour is fluorescent (chartreuse or hot magenta) and labels on it are black."
  },
  "name": "Acid Graphics (moves)",
  "descriptor": "Toxic · Warped · Loud",
  "influences": "Rave flyers / Op-art / Warped type",
  "summary": "Vibrating colour pairs, stretched type and dense information over a hidden calm grid.",
  "coreTrick": "The primary is pushed to full chroma and paired with a computed fluorescent clash colour at near-equal luminance, then every display line is individually warped (stretched on a wave, compressed, outlined with echoes) over a hidden 12-column grid.",
  "motto": "Turn it up until it hums.",
  "kicker": "Doors at midnight",
  "mode": "dark",
  "slideShape": "minimal",
  "labels": {
    "material": "Signal",
    "states": [
      "Idle",
      "Strobe",
      "Melt"
    ],
    "statesKind": "button"
  },
  "copy": {
    "motto": {
      "label": "Motto",
      "text": "Turn it up until it hums."
    },
    "kicker": {
      "label": "Kicker above the headline",
      "text": "Doors at midnight"
    },
    "state0": {
      "label": "State 1 name",
      "text": "Idle"
    },
    "state1": {
      "label": "State 2 name",
      "text": "Strobe"
    },
    "state2": {
      "label": "State 3 name",
      "text": "Melt"
    }
  },
  "layout": {
    "hero": "split",
    "palette": "strips",
    "sections": "two-col",
    "subcopy": true
  },
  "type": {
    "ui": "body",
    "label": "mono",
    "display": 1
  },
  "highlight": "custom",
  "highlightNote": "The last headline line is an outline only with two offset echoes in the pair; the lines above are stretched on a wave and compressed. In running UI text the highlight word is plain ink.",
  "roles": {
    "canvas": {
      "use": "The neutral rest area (about 30% of every view): near-black in dark mode, stark white in light mode; a hidden 12-column grid runs under it at 4-6%",
      "never": "Text, gradients, a tinted wash; it is the silence that lets the density breathe",
      "coverage": "30–40%"
    },
    "ink": {
      "use": "White (dark) or black (light) body copy, mono info labels, the numerals and the 12-column grid lines",
      "never": "Vibrating pairs: thin ink type is never set on a vibrating edge",
      "coverage": "15–20%"
    },
    "primary": {
      "use": "The dominant colour: the client primary pushed to full chroma (a muted primary falls back to a fixed lime): the headline, the main action fill, the selected tab. Its computed clash partner sits at equal luminance",
      "never": "Thin text on a vibrating edge, a neutral flat fill, a second CTA",
      "coverage": "≈25–30%"
    },
    "secondary": {
      "use": "The pattern's second band and tinted shadow: stripes, the progress track",
      "never": "The main action, body text, replacing the computed clash colour",
      "coverage": "≈10%"
    },
    "accent": {
      "use": "One spot colour, used sparingly: the focus ring and a single spark",
      "never": "Buttons, body text, borders, large fills",
      "coverage": "≤4%"
    }
  },
  "rules": {
    "do": [
      "Pair the dominant colour with its computed fluorescent clash and let them meet edge to edge.",
      "Distort every display line differently (stretch on a wave, compress one line, outline-echo the last); keep dates, tabs, strips and labels in clean mono caps.",
      "Keep a neutral rest area of about 30% and a hidden 12-column grid under the layers.",
      "Use tickets, perforated tabs, legend switches and equaliser bars as the interface vocabulary."
    ],
    "dont": [
      "Set thin type on a vibrating edge, or neon text on neon; body copy stays ink on the neutral.",
      "Warp every line the same way or drop the grid; without a resting area there is no hierarchy.",
      "Use chrome, glossy gradients or blobs: here the vibration of two colours is the effect."
    ]
  },
  "deck": {
    "marks": {
      "do": "✱",
      "dont": "✕"
    },
    "principles": [
      [
        "Colour that vibrates",
        "Two near-equal-luminance hues meet edge to edge."
      ],
      [
        "Warp every line",
        "Stretch, compress, echo: each display line differently."
      ],
      [
        "Order underneath the noise",
        "A hidden calm grid holds the dense layout together."
      ]
    ],
    "do": [
      "Pair the primary with a computed clash colour.",
      "Distort every display line differently.",
      "Keep dates, tabs and strips scannable."
    ],
    "dont": [
      "Put thin type on a vibrating edge.",
      "Warp every line the same way.",
      "Use chrome or gloss."
    ]
  },
