{
 "spec": 2,
 "key": "youch-marker-proof",
 "order": 960,
 "name": "Marker Proof",
 "descriptor": "Highlighted · Plain · Faithful",
 "influences": "Highlighter pens on printed transcripts / Proofreader marks / Mac Notes and Mail / Gong and Zoom transcripts",
 "summary": "Plain white paper cards under one hairline, where only the thing you chose is ever filled, like a highlighter on a transcript.",
 "coreTrick": "Nothing rests filled or shadowed: every surface is bare paper under a single 1px hairline, and only a chosen thing (selected, current, open, focused, the one main action) takes a flat highlighter band of the primary, which a press darkens and a disabled control strikes through with a diagonal hatch.",
 "motto": "Only what you marked.",
 "kicker": "Said, kept, marked",
 "mode": "light",
 "lineage": {
  "forkedFrom": null,
  "version": 1
 },
 "meta": {
  "family": "digital",
  "fonts": {
   "heading": {
    "classes": [
     "geometric"
    ],
    "picks": [
     "Manrope",
     "Plus Jakarta Sans"
    ]
   },
   "body": {
    "classes": [
     "neo-grotesk"
    ],
    "picks": [
     "Inter",
     "Geist"
    ]
   },
   "mono": {
    "picks": [
     "JetBrains Mono",
     "IBM Plex Mono"
    ]
   },
   "avoid": [
    "script",
    "groovy",
    "blackletter",
    "deco",
    "pixel",
    "condensed"
   ],
   "why": "A transcript tool should read like plain proofed text: a tight geometric heading over a neutral grotesk body, with tabular numerals for counts and times.",
   "pairings": [
    [
     "Manrope",
     "Inter"
    ],
    [
     "Plus Jakarta Sans",
     "Inter"
    ],
    [
     "Manrope",
     "Geist"
    ]
   ]
  }
 },
 "build": {
  "cls": "flat",
  "surface": "Bare paper surfaces with a 1px hairline and no shadow. Corners 20 on cards, 12 on controls, pills for badges. Fields are shallow wells (a 2px inset shade). Colour appears only as a flat highlighter band on what is chosen.",
  "press": {
   "dx": 0,
   "dy": 1,
   "ms": 90
  },
  "motion": {
   "fast": 90,
   "base": 140,
   "slow": 220,
   "ease": "out"
  },
  "pressText": "Rest is flat. Hover tints the paper a step toward the primary. Pressed darkens the highlighter fill and moves 1px down in 90 ms; there is no lip, no shadow and no bounce. Disabled strikes through with a 3px diagonal hatch. Focus is a 2px primary outline, 3px off the edge.",
  "icons": "1.75px strokes, round caps, 20px; the selected icon sits on a highlighter band.",
  "appIcon": "A white rounded tile with one highlighted word-bar in the primary."
 },
 "labels": {
  "material": "Highlighter band",
  "states": [
   "Rest",
   "Marked",
   "Pressed"
  ],
  "statesKind": "chip"
 },
 "copy": {
  "motto": {
   "label": "Motto",
   "text": "Only what you marked."
  },
  "kicker": {
   "label": "Kicker above the headline",
   "text": "Said, kept, marked"
  }
 },
 "layout": {
  "hero": "split",
  "palette": "swatches",
  "sections": "two-col"
 },
 "type": {
  "ui": "sans",
  "label": "sans",
  "display": 1
 },
 "roles": {
  "canvas": {
   "use": "Page and panel background, tinted slightly toward the primary hue",
   "never": "Text",
   "coverage": "60-70%"
  },
  "ink": {
   "use": "Headlines, body text, borders, hover fill",
   "never": "Large background fields in light mode",
   "coverage": "15-20%"
  },
  "primary": {
   "use": "The one main action per view; selected state",
   "never": "Body text; more than one CTA per view",
   "coverage": "about 10%"
  },
  "secondary": {
   "use": "Secondary buttons, chips, second data series",
   "never": "The main CTA, body text",
   "coverage": "10-15%"
  },
  "accent": {
   "use": "One spark per view: the highlighted headline word, new badges",
   "never": "Buttons, body text, borders, large fills",
   "coverage": "5% or less"
  }
 },
 "rules": {
  "do": [
   "Keep every resting surface bare paper under a 1px hairline with no shadow.",
   "Fill only what is chosen: selected, current, open, focused or the one main action.",
   "Draw the main action as a flat primary band, one per screen.",
   "Strike a disabled control through with the diagonal hatch rather than greying it.",
   "Set counts, times and word totals in tabular numerals."
  ],
  "dont": [
   "Use a shadow, lip, gradient or glow on any resting surface.",
   "Fill a card or row at rest.",
   "Put art, textures or decorative bands on app screens.",
   "Draw errors in stock red: use ink, an icon and words.",
   "Mark more than one thing per group as chosen."
  ]
 },
 "highlight": "ink",
 "slideShape": "soft",
 "colour": [
