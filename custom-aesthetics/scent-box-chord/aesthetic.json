 },
 "roles": {
  "canvas": {
   "use": "The ground; near-black in dark, warm off-white in light",
   "never": "Text",
   "coverage": "60-70%"
  },
  "ink": {
   "use": "All type, the heavy underline on the primary action, the selected strip's tick",
   "never": "Large fills; boxes around content",
   "coverage": "15-20%"
  },
  "primary": {
   "use": "The one main action, drawn as heavy-underlined text; nothing else",
   "never": "Strips, tiles or panels",
   "coverage": "about 3%"
  },
  "secondary": {
   "use": "Quiet separators and disabled text",
   "never": "The main action",
   "coverage": "5%"
  },
  "accent": {
   "use": "Nothing in the interface; the accord colours belong to the scents",
   "never": "Buttons, rules, selection, type",
   "coverage": "0% of chrome"
  }
 },
 "rules": {
  "do": [
   "Draw every fragrance as a strip or bar split by accord weight in the accords' own colours; the chord is the first read on every screen.",
   "Keep controls as plain text with an underline: Add fragrance and Save are heavy-underlined words in the toolbar, never filled blocks.",
   "Set one number huge per screen (the shelf count or the rating) and cap it at roughly twice the strip height; everything else is small.",
   "Label strips by house, under each group, in small sentence-case type.",
   "Draw notes as three stacked bands in time order (top, heart, base), each note in its own colour, beside a tall scent strip.",
   "Use the whole Mac width: toolbar tabs, the spectrum across the window, the readout beneath; never a centred phone column."
  ],
  "dont": [
   "Put anything in a grey tile, a soft-tint box or a bento grid (the owner called it 'really cheap and like not thought out at all').",
   "Use a black or filled slab for Add or Save, an arrow on a button, or a full-width button inside content.",
   "Use tracked capitals for labels or buttons, boxed badges like '7 BOTTLES' or 'OUT OF 10', or italic placeholders.",
   "Tint chords with the brand colour; chords use only the accord colours.",
   "Show 'aromatic 100' label and value rows or five glyph stars; use weighted bars and one numeral.",
   "Add bottle illustrations, patterns or art to any app screen."
  ]
 },
