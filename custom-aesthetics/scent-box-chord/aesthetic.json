{
 "spec": 2,
 "key": "scent-box-chord",
 "order": 955,
 "name": "Scent Box Chord",
 "descriptor": "Spectral · Bare · Loud",
 "influences": "Paint-chip fans and barcode-like colour strips; the perfumer's accord chord; Swiss grotesque posters set huge on a dark ground",
 "summary": "A bare dark interface where every fragrance is a strip of its own accord colours, split by weight, and nothing else on screen owns a colour.",
 "coreTrick": "Every control is plain type on the ground with an underline, so the only colour on screen is each scent's accord chord: a bar split by weight in the accords' own colours.",
 "motto": "The shelf is a spectrum.",
 "kicker": "37 fragrances",
 "mode": "dark",
 "lineage": {
  "forkedFrom": null,
  "version": 1
 },
 "meta": {
  "family": "graphic",
  "fonts": {
   "heading": {
    "classes": [
     "grotesk"
    ],
    "picks": [
     "Bricolage Grotesque"
    ]
   },
   "body": {
    "classes": [
     "neo-grotesk"
    ],
    "picks": [
     "Inter Tight",
     "Figtree"
    ]
   },
   "mono": {
    "picks": [
     "Geist Mono"
    ]
   },
   "avoid": [
    "serif",
    "script",
    "slab",
    "groovy",
    "pixel",
    "blackletter",
    "mono"
   ],
   "why": "Names and the shelf count are set huge in a heavy, characterful grotesque so they stand against the strips; facts stay in a quiet neo-grotesk. Nothing is tracked capitals.",
   "pairings": [
    [
     "Bricolage Grotesque",
     "Inter Tight"
    ],
    [
     "Bricolage Grotesque",
     "Figtree"
    ]
   ]
  }
 },
 "build": {
  "cls": "flat",
  "surface": "No containers: strips of colour and type sit directly on the ground; controls are text with an underline; corners are square.",
  "press": {
   "opacity": 0.7,
   "ms": 90
  },
  "motion": {
   "fast": 90,
   "base": 140,
   "slow": 220,
   "ease": "out"
  },
  "pressText": "A pressed control drops to 70% opacity over 90 ms, ease-out; a selected strip rises 12px over 140 ms; focus is a 2px ink outline 3px off the control.",
  "icons": "One 1.5pt line set, only where the label does not say it; square caps, no filled shapes.",
  "appIcon": "A dark ground with a row of narrow vertical colour strips of unequal height."
 },
